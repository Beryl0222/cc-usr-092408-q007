{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "公园需求试点账领域事件",
  "description": "只追加的事件信封。事件一旦接收，event_id / aggregate_id / occurred_at / version 不得原地改写；业务更正只能产生后继事件。聚类（NEEDS_CLUSTERED）的 payload.advisory 恒为 true：聚类是建议而非事实。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "内容寻址：由 event_type + aggregate_id + version + payload 确定，重复回放生成同一 ID。"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "NEED_LOGGED",
        "NEEDS_CLUSTERED",
        "PILOT_APPROVED",
        "RESOURCES_RESERVED",
        "RESOURCES_ADJUSTED",
        "RESOURCES_RELEASED",
        "RESOURCE_USAGE_LOGGED",
        "OBSERVATION_RECORDED",
        "SAFETY_HALT_TRIGGERED",
        "METRIC_DEVIATION_FLAGGED",
        "REVIEW_SCHEDULED",
        "REVIEW_RESOLVED",
        "PILOT_DECIDED",
        "NOTIFICATION_SENT"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "community_need",
        "need_cluster",
        "pilot_measure",
        "observation_window"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "业务发生时间（观测按此排序入流）；事件信封时间不等于决策可被改写。"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一 aggregate_id 内严格递增。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件负载。NEED_LOGGED 只允许去标识摘要与来源群体，不保存个人标识。"
    }
  },
  "additionalProperties": false
}
